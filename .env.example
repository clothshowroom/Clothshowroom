# Brand-new, isolated Supabase credentials for Cloth Showroom
# Copy this file to `.env.local` and fill in values from your NEW Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional comma-separated list of admin email addresses allowed into /admin.
# Leave empty to permit any authenticated user created in this Supabase project's Auth -> Users.
NEXT_PUBLIC_ADMIN_EMAILS=
